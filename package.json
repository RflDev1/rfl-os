{
  "name": "realm-fighting-league",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "next": {
      "postcss": "8.5.14"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:preview": "tsx scripts/dev-preview.ts",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-database.ts",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:e2e:run": "playwright test",
    "deploy:check": "tsx scripts/deploy-preflight.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
