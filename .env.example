# Canonical URL for this environment. Never copy production secrets locally.
APP_URL="https://playrfl.com"
# Canonical Auth.js origin used for OAuth callbacks and post-login redirects.
AUTH_URL="https://playrfl.com"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rfl?sslmode=verify-full"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rfl?sslmode=verify-full"
AUTH_SECRET="generate-a-long-random-value"
DISCORD_CLIENT_ID="your-discord-application-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"
# Discord Developer Portal → General Information → Public Key.
DISCORD_PUBLIC_KEY="your-64-character-discord-public-key"
DISCORD_API_BASE_URL="https://discord.com/api/v10"
DISCORD_GUILD_ID="1514881431229431868"
# Discord ticket channel opened by the public Become a Fighter page.
BECOME_FIGHTER_DISCORD_URL="https://discord.com/channels/1514881431229431868/1530421080324308993"
REMINDER_JOB_SECRET="generate-another-long-random-value"
DAILY_REWARD_AMOUNT="100"
COIN_FLIP_MIN_WAGER="10"
COIN_FLIP_MAX_WAGER="1000"
COIN_FLIP_PAYOUT_BPS="20000"
COIN_FLIP_MAX_PLAYS_PER_MINUTE="12"
BLACKJACK_MIN_WAGER="10"
BLACKJACK_MAX_WAGER="1000"
BLACKJACK_PAYOUT_BPS="20000"
BLACKJACK_NATURAL_PAYOUT_BPS="25000"
BLACKJACK_MAX_ROUNDS_PER_MINUTE="6"
HIGH_LOW_MIN_WAGER="10"
HIGH_LOW_MAX_WAGER="1000"
HIGH_LOW_TARGET_RETURN_BPS="9500"
HIGH_LOW_MAX_STEPS="7"
HIGH_LOW_MAX_ROUNDS_PER_MINUTE="6"
BET_MIN_WAGER="10"
BET_MAX_WAGER="5000"
BET_MAX_PLACEMENTS_PER_MINUTE="10"
PACK_MAX_OPENINGS_PER_MINUTE="6"
MARKET_MIN_PRICE="10"
MARKET_MAX_PRICE="100000"
FIGHT_REQUEST_RANK_RANGE="5"
FIGHT_POOL_ENABLED="false"
FIGHT_POOL_WIN_REWARD="100"
FIGHT_POOL_CODE_TTL_MINUTES="10"
FIGHT_POOL_PRESENCE_TTL_SECONDS="45"
# Generate separate random values of at least 32 characters. Never commit real values.
FIGHT_POOL_BRIDGE_SECRET="generate-a-long-random-bridge-secret"
FIGHT_POOL_CODE_SECRET="generate-a-long-random-code-encryption-secret"
# Optional: grants ADMIN when this exact Discord account first links.
BOOTSTRAP_ADMIN_DISCORD_ID=""
# Optional role sync. Set both values to grant restricted control-center access
# to members who hold the configured Discord role.
FIGHTER_ANALYST_DISCORD_ROLE_ID="1516694555112767529"
LOG_LEVEL="info"

# Local PostgreSQL container settings. Choose local-only values.
POSTGRES_DB="rfl"
POSTGRES_USER="rfl"
POSTGRES_PASSWORD="replace-for-local-development"
POSTGRES_PORT="5432"
